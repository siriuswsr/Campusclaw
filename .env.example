# Runtime secrets — NEVER commit this file
# Copy from .env.example and fill in local values

# --- JWT (REQUIRED) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# --- MySQL (Docker Compose sets internal values automatically; keep these as defaults) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=campusclaw
MYSQL_USER=campus
MYSQL_PASSWORD=campus

# --- Uploads ---
UPLOAD_DIR=/app/uploads

# --- Qdrant (Compose internal URL: app→qdrant) ---
# QDRANT_URL default set in compose; override here only if needed

# --- Embedding gateway — 课程官方网关（OpenAI /embeddings 兼容）— ALL REQUIRED ---
# 变量名对齐课程网关页面：BASE_URL 只写到 /v1，代码自己接 /embeddings。
# EMBEDDING_DIM 不是请求参数，是建库与校验返回向量长度的依据。
EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
EMBEDDING_API_KEY=sk-course-embedding-key
EMBEDDING_MODEL=course-embedding
EMBEDDING_DIM=2048

# --- QA gateway — 同一官方网关的对话接口（chat.completions）— ALL REQUIRED ---
QA_URL=https://ai-gateway.devops.hello1023.com/v1
QA_KEY=sk-course-qa-key
QA_MODEL=course-chat

# --- Assistant chat gateway (lesson 5, stream=true) — optional ---
# CHAT_BASE_URL is the API ROOT (code appends /chat/completions). Defaults to
# https://ai-gateway.devops.hello1023.com/v1 with model course-chat.
# CHAT_API_KEY falls back to QA_KEY when unset.
# CHAT_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
# CHAT_API_KEY=sk-course-qa-key
# CHAT_MODEL=course-chat

# --- MCP demo tool server (lesson 8) — shared bearer token ---
# mcp-demo reads MCP_AUTH_TOKEN at runtime; the app never receives it directly —
# teachers register a server with its token, which is stored server-side only.
MCP_AUTH_TOKEN=replace-with-a-random-token
MCP_PORT=8090
