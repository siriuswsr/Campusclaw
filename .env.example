# Runtime secrets — NEVER commit this file
# Copy from .env.example and fill in local values

# --- Flask (REQUIRED) ---
SECRET_KEY=replace-with-a-long-random-string

# --- MySQL (Docker Compose sets internal values automatically; keep these as defaults) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=campusclaw
MYSQL_USER=campus
MYSQL_PASSWORD=campus

# --- Uploads ---
UPLOAD_DIR=/app/uploads

# --- Qdrant (Compose internal URL: app→qdrant) ---
# QDRANT_URL default set in compose; override here only if needed

# --- Embedding gateway (OpenAI /embeddings compatible) — ALL REQUIRED ---
EMBEDDING_URL=https://course-gateway.example.com/v1
EMBEDDING_KEY=sk-course-embedding-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- QA gateway (OpenAI chat.completions compatible) — ALL REQUIRED ---
QA_URL=https://course-gateway.example.com/v1
QA_KEY=sk-course-qa-key
QA_MODEL=gpt-4o-mini
